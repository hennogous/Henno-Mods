<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="12.0" DefaultTargets="Default" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Default</Configuration>
    <Name>CSC Art Pack</Name>
    <Guid>d96a046a-ce49-4701-94cf-e22d431f5ff4</Guid>
    <ProjectGuid>d54001bc-afb6-463e-9648-63e4262a95ba</ProjectGuid>
    <ModVersion>1</ModVersion>
    <Teaser>Optional alternate building models for Civ Supply Chains.</Teaser>
    <Description>Adds alternate building models to Civ Supply Chains. Includes expanded Bakers' and Tailors' building models.</Description>
    <Authors>Shadow</Authors>
    <SpecialThanks>
    </SpecialThanks>
    <AffectsSavedGames>false</AffectsSavedGames>
    <SupportsSinglePlayer>true</SupportsSinglePlayer>
    <SupportsMultiplayer>true</SupportsMultiplayer>
    <SupportsHotSeat>true</SupportsHotSeat>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
    <AssemblyName>CSC Art Pack</AssemblyName>
    <RootNamespace>CSC Art Pack</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Default' ">
    <OutputPath>.</OutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <InGameActionData><![CDATA[<InGameActions><UpdateDatabase id="CSC_ArtPack_Properties"><Properties><LoadOrder>200</LoadOrder></Properties><File>Data/CSC_ArtPack_Properties.sql</File></UpdateDatabase><AddGameplayScripts id="CSC_ArtPack_ArtProperties"><Properties><LoadOrder>501</LoadOrder></Properties><File>Lua_UI/ArtProperties/CSC_ArtProperties.lua</File></AddGameplayScripts><UpdateArt id="CSC_ArtPack_UpdateArt"><Properties><LoadOrder>200</LoadOrder></Properties><File>(Mod Art Dependency File)</File></UpdateArt></InGameActions>]]></InGameActionData>
    <AssociationData><![CDATA[<Associations><Dependency type="Mod" title="Civ Supply Chains" id="c5e66bd1-d804-443b-ac3d-1917a20dba3c" /></Associations>]]></AssociationData>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Finish ModBuddy Build.cmd" />
    <None Include="Finish ModBuddy Build.ps1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="CSC Art Pack.Art.xml">
      <SubType>Content</SubType>
    </Content>
    <Content Include="ArtDefs\CSC_GamePropertyRanges.artdef">
      <SubType>Content</SubType>
    </Content>
    <Content Include="Data\CSC_ArtPack_Properties.sql">
      <SubType>Content</SubType>
    </Content>
    <Content Include="Lua_UI\ArtProperties\CSC_ArtProperties.lua">
      <SubType>Content</SubType>
    </Content>
    <Content Include="ArtDefs\CSC_ArtPack_Landmarks.artdef">
      <SubType>Content</SubType>
    </Content>
    <Content Include="XLPs\CSC_ArtPack_Tilebases.xlp">
      <SubType>Content</SubType>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="ArtDefs\" />
    <Folder Include="Data\" />
    <Folder Include="Lua_UI\" />
    <Folder Include="Lua_UI\ArtProperties\" />
    <Folder Include="XLPs\" />
  </ItemGroup>
  <Import Project="$(MSBuildLocalExtensionPath)Civ6.targets" />
</Project>