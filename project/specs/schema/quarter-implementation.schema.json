{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CSC Quarter Implementation Contract",
  "type": "object",
  "required": [
    "schema_version",
    "quarter",
    "status",
    "design_contract",
    "gameplay_catalog",
    "localization_catalog",
    "sql_style_catalog",
    "icon_atlas_layout",
    "planned_outputs",
    "build_wiring",
    "phase_validation",
    "validation_ownership",
    "sql_style_profiles",
    "implementation_rules",
    "preserved_inputs",
    "phases",
    "resolved_engine_decisions",
    "open_engine_decisions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "quarter": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "approved", "implementing", "complete", "superseded"]},
    "icon_atlas_layout": {
      "type": "object",
      "required": ["source", "overrides"],
      "properties": {
        "source": {"const": "gameplay_catalog"},
        "overrides": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "district_normal",
              "district_fow",
              "stage2_building",
              "stage3_building",
              "stage4_building",
              "stage2_service",
              "stage3_service",
              "stage4_service"
            ]
          },
          "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 15}
        }
      },
      "additionalProperties": false
    },
    "planned_outputs": {
      "type": "object",
      "required": ["core", "gold", "monopolies", "monopolies_gold", "localization_source", "localization_generated"],
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "build_wiring": {
      "type": "object",
      "required": ["action_manifest", "source_project", "actions"],
      "properties": {
        "action_manifest": {"type": "string", "minLength": 1},
        "source_project": {"type": "string", "minLength": 1},
        "criteria_contracts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["kind", "value", "inverse"],
            "properties": {
              "kind": {"enum": ["ModInUse"]},
              "value": {"type": "string", "minLength": 1},
              "inverse": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "actions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["id", "type", "file", "load_order", "criteria"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "type": {"enum": ["UpdateDatabase", "UpdateText", "UpdateIcons", "ImportFiles", "AddGameplayScripts", "AddUserInterfaces", "ReplaceUIScript"]},
              "file": {"type": "string", "minLength": 1},
              "load_order": {"oneOf": [{"type": "integer"}, {"type": "string", "pattern": "^-?[0-9]+$"}]},
              "criteria": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "lua_context": {"type": "string", "minLength": 1}
            },
            "allOf": [
              {
                "if": {"properties": {"type": {"const": "ReplaceUIScript"}}},
                "then": {"required": ["lua_context"]}
              }
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "phase_validation": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["required_outputs", "required_suites", "assertion_module"],
        "properties": {
          "assertion_module": {"type": "string", "minLength": 1},
          "required_outputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "required_suites": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "contract",
                "output_completeness",
                "sql_style",
                "sql_statement_boundaries",
                "semantic_rows",
                "modifier_graph",
                "replacement_coverage",
                "localization_generation",
                "localization_patterns",
                "modbuddy_wiring",
                "conditional_load_boundaries",
                "lua_contract"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "validation_ownership": {
      "type": "object",
      "required": ["automated", "in_game"],
      "properties": {
        "automated": {
          "type": "object",
          "required": ["owner", "required_before_handoff", "scope"],
          "properties": {
            "owner": {"const": "implementation_agent"},
            "required_before_handoff": {"const": true},
            "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "in_game": {
          "type": "object",
          "required": ["owner", "required_before_handoff", "required_for_final_acceptance", "scenarios_field"],
          "properties": {
            "owner": {"const": "user"},
            "required_before_handoff": {"const": false},
            "required_for_final_acceptance": {"type": "boolean"},
            "scenarios_field": {"const": "runtime_scenarios"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sql_style_profiles": {
      "type": "object",
      "required": ["core", "gold", "monopolies", "monopolies_gold"],
      "additionalProperties": {
        "enum": ["core", "gold", "monopolies", "monopolies_gold"]
      }
    },
    "preserved_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "pattern", "file", "resource", "class"]
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "purpose", "requirements"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "design_refs",
                "gameplay_patterns",
                "localization_patterns",
                "outputs",
                "static_assertions",
                "runtime_scenarios"
              ],
              "properties": {
                "id": {"type": "string", "pattern": "^I\\.[A-Z0-9_]+(?:\\.[A-Z0-9_]+)*$"},
                "design_refs": {"type": "array", "items": {"type": "string"}},
                "gameplay_patterns": {"type": "array", "items": {"type": "string"}},
                "localization_patterns": {"type": "array", "items": {"type": "string"}},
                "outputs": {"type": "array", "items": {"type": "string"}},
                "static_assertions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "runtime_scenarios": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "trade_route_yield_presentation": {"$ref": "#/$defs/tradeRouteYieldPresentationBinding"},
                "wonder_service_binding": {"$ref": "#/$defs/wonderServiceBinding"}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "resolved_engine_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "affects", "resolution"],
        "properties": {
          "id": {"type": "string", "pattern": "^E\\."},
          "affects": {
            "oneOf": [
              {"type": "string", "pattern": "^I\\.[A-Z0-9_]+(?:\\.[A-Z0-9_]+)*$"},
              {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^I\\.[A-Z0-9_]+(?:\\.[A-Z0-9_]+)*$"}}
            ]
          },
          "resolution": {"type": "string", "minLength": 1},
          "decided_by": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "open_engine_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "affects", "question", "resolution_required_before_phase"]
      }
    }
  },
  "$defs": {
    "tradeRouteYieldPresentationBinding": {
      "type": "object",
      "required": ["registry_table", "registry_output", "ui_output", "entries"],
      "properties": {
        "registry_table": {"const": "CSC_TradeRouteYieldPresentation"},
        "registry_output": {"type": "string", "minLength": 1},
        "ui_output": {"type": "string", "minLength": 1},
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["entry_id", "quarter_key", "modifier_id", "property_name", "property_scope", "yield_type", "amount", "display_bucket"],
            "properties": {
              "entry_id": {"type": "string", "pattern": "^CSC_[A-Z][A-Z0-9_]*_IMPORT_(CONSUMER|SPECIALTY)_[A-Z][A-Z0-9_]*$"},
              "quarter_key": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
              "modifier_id": {"type": "string", "pattern": "^MOD_CSC_[A-Z0-9_]+$"},
              "property_name": {"type": "string", "pattern": "^CSC_[A-Z0-9_]+$"},
              "property_scope": {"const": "CITY_CENTER_PLOT"},
              "yield_type": {"type": "string", "pattern": "^YIELD_[A-Z0-9_]+$"},
              "amount": {"type": "number", "exclusiveMinimum": 0},
              "display_bucket": {"const": "OUTGOING_TRADE_ROUTES"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "wonderServiceBinding": {
      "type": "object",
      "required": ["wonder_variants", "placement", "ui"],
      "properties": {
        "normal_destination": {
          "type": "object",
          "required": ["service_building_type", "district_type", "customer_building_type", "placement_method", "citizen_slots"],
          "properties": {
            "service_building_type": {"type": "string", "minLength": 1},
            "district_type": {"type": "string", "minLength": 1},
            "customer_building_type": {"type": "string", "minLength": 1},
            "placement_method": {"const": "persistent_sql_grant"},
            "citizen_slots": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "wonder_variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["host_wonder_type", "service_building_type", "activation_property"],
            "properties": {
              "host_wonder_type": {"type": "string", "minLength": 1},
              "service_building_type": {"type": "string", "minLength": 1},
              "activation_property": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "placement": {
          "type": "object",
          "required": ["method", "output", "building_prereq_district", "wonder_citizen_slots", "sql_grant_modifier", "create_api", "gameplay_location_api", "persistent_after_activation", "relocate_misplaced", "remove_orphans", "deterministic", "refresh_events"],
          "properties": {
            "method": {"const": "gameplay_lua_exact_plot_reconciler"},
            "output": {"type": "string", "minLength": 1},
            "building_prereq_district": {"const": "DISTRICT_WONDER"},
            "wonder_citizen_slots": {"const": 0},
            "sql_grant_modifier": {"const": false},
            "create_api": {"const": "CityBuildQueue.CreateBuilding(buildingIndex, plotIndex)"},
            "gameplay_location_api": {"const": "CityBuildings.GetBuildingLocation"},
            "persistent_after_activation": {"const": true},
            "relocate_misplaced": {"const": true},
            "remove_orphans": {"const": true},
            "deterministic": {"const": true},
            "refresh_events": {
              "type": "array",
              "minItems": 4,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          },
          "additionalProperties": false
        },
        "ui": {
          "type": "object",
          "required": ["city_breakdown", "plot_tooltip", "location_api", "spoof_location", "city_breakdown_output", "base_plot_tooltip_output", "suk_plot_tooltip_output"],
          "properties": {
            "city_breakdown": {"const": "actual_plot_nested_under_host_wonder"},
            "plot_tooltip": {"const": "actual_buildings_at_location"},
            "location_api": {"const": "CityBuildings.GetBuildingsAtLocation"},
            "spoof_location": {"const": false},
            "city_breakdown_output": {"type": "string", "minLength": 1},
            "base_plot_tooltip_output": {"type": "string", "minLength": 1},
            "suk_plot_tooltip_output": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
