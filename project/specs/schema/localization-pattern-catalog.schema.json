{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CSC Localization Pattern Catalog",
  "type": "object",
  "required": [
    "schema_version",
    "catalog_id",
    "purpose",
    "reference_file",
    "global_rules",
    "authorship_modes",
    "district_description_order",
    "building_description_order",
    "patterns"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "reference_file": {"type": "string", "minLength": 1},
    "global_rules": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "authorship_modes": {
      "type": "object",
      "required": [
        "strict_template",
        "deterministic_composition",
        "structured_original_prose",
        "curated_integrated_prose",
        "mixed_by_surface"
      ],
      "properties": {
        "strict_template": {"type": "string", "minLength": 1},
        "deterministic_composition": {"type": "string", "minLength": 1},
        "structured_original_prose": {"type": "string", "minLength": 1},
        "curated_integrated_prose": {"type": "string", "minLength": 1},
        "mixed_by_surface": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "building_description_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "district_description_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/pattern"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "pattern": {
      "type": "object",
      "required": ["id", "classification", "applies_to", "authorship_mode", "authorship_guidance"],
      "properties": {
        "id": {"type": "string", "pattern": "^LP\\.[A-Z0-9_.]+$"},
        "classification": {
          "enum": [
            "exact_bakers_parameterized",
            "exact_bakers_parameterized_with_tailors_amenity_suffix",
            "exact_bakers_structure",
            "exact_bakers_structure_optional",
            "design_extension_no_bakers_analogue"
          ]
        },
        "applies_to": {
          "enum": [
            "district_description",
            "building_description",
            "service_description",
            "pedia",
            "civic_description",
            "notification",
            "names"
          ]
        },
        "authorship_mode": {
          "enum": [
            "strict_template",
            "deterministic_composition",
            "structured_original_prose",
            "curated_integrated_prose",
            "mixed_by_surface"
          ]
        },
        "authorship_guidance": {"$ref": "#/$defs/nonEmptyStringArray"},
        "source_anchor": {"type": "string", "minLength": 1},
        "template": {"type": "string", "minLength": 1},
        "required_slots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"}
        },
        "order_group": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "invariant": {"$ref": "#/$defs/nonEmptyStringArray"},
        "required_chapters": {"$ref": "#/$defs/nonEmptyStringArray"},
        "variants": {"$ref": "#/$defs/nonEmptyStringArray"},
        "required": {"$ref": "#/$defs/nonEmptyStringArray"}
      },
      "allOf": [
        {
          "if": {"required": ["template"]},
          "then": {"required": ["required_slots"]},
          "else": {
            "anyOf": [
              {"required": ["invariant"]},
              {"required": ["required_chapters"]},
              {"required": ["variants"]},
              {"required": ["required"]}
            ]
          }
        },
        {
          "if": {
            "properties": {"classification": {"pattern": "^exact_bakers"}},
            "required": ["classification"]
          },
          "then": {"required": ["source_anchor"]}
        },
        {
          "if": {"required": ["order_group"]},
          "then": {
            "properties": {"applies_to": {"const": "building_description"}}
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
