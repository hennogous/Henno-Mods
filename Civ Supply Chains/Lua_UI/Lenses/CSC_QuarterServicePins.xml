<?xml version="1.0" encoding="utf-8"?>
<!-- Camera-facing world UI. The anchor scales the whole badge and its hit
     areas with zoom. The controls draw whole 256px atlas slots at the
     Flax-matched map size. -->
<Context Layer="WorldAnchor">
  <Container ID="ServicePins"/>
  <Instance Name="QuarterServicePin">
    <WorldAnchor ID="Anchor" Scaling="1" UnitsPerPixel="0.037" Billboard="1">
      <Container ID="PinRoot" Anchor="C,C" Size="510,510">
        <Image ID="Backing" Texture="CSC_ServiceMedallion.dds" Size="383,383" Anchor="C,C" StretchMode="Fill"/>
        <Button ID="ServiceButton" Size="383,383" Anchor="C,C" NoDefaultSound="1">
          <Image ID="ServiceIcon" Size="256,256" Anchor="C,C" Offset="0,-6"/>
          <Image ID="QuarterIcon" Size="256,256" Anchor="C,C"
                 Hidden="1" ConsumeMouse="0"/>
        </Button>
      </Container>
    </WorldAnchor>
  </Instance>
</Context>
